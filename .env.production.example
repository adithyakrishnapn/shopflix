APP_NAME="ShopFlix"
APP_ENV=production
APP_KEY=base64:CHANGE_ME_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_DEBUG_ALLOWED_IPS=
APP_URL=http://your-server-host
APP_ADMIN_URL=admin
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_CURRENCY=INR
APP_FORCE_HTTPS=false
ASSET_URL=http://your-server-host
PORT=10000

# Install / deployment behavior
BAGISTO_INSTALLATION_TYPE=cream
BAGISTO_SEED_BASE_DATA=true
FORCE_FRESH_INSTALL=false
FORCE_INSTALLER=false

LOG_CHANNEL=stderr
LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=shopflix
DB_USERNAME=shopflix
DB_PASSWORD=change_me
DB_PREFIX=
DB_SOCKET=
DB_SSLMODE=disable

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_CONNECTION=
SESSION_DRIVER=file
SESSION_CONNECTION=
SESSION_STORE=
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
QUEUE_DRIVER=sync
QUEUE_FAILED_DRIVER=database-uuids

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DEFAULT_DATABASE=0
REDIS_CACHE_DATABASE=1
REDIS_SESSION_DATABASE=2

RESPONSE_CACHE_ENABLED=false
RESPONSE_CACHE_DRIVER=file
RESPONSE_CACHE_LIFETIME=604800
RESPONSE_CACHE_HEADER_NAME=laravel-responsecache
RESPONSE_CACHE_AGE_HEADER=true
RESPONSE_CACHE_AGE_HEADER_NAME=laravel-responsecache-age
CACHE_BYPASS_HEADER_NAME=
CACHE_BYPASS_HEADER_VALUE=

FILESYSTEM_DISK=public
FILESYSTEM_CLOUD=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_URL=

MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_PERSISTENT_ID=

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_LOG_CHANNEL=
MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs -i
MAIL_FROM_ADDRESS=shop@example.com
MAIL_FROM_NAME="ShopFlix"
ADMIN_MAIL_ADDRESS=admin@example.com
ADMIN_MAIL_NAME="ShopFlix Admin"
CONTACT_MAIL_ADDRESS=contact@example.com
CONTACT_MAIL_NAME="ShopFlix Contact"

MAILGUN_DOMAIN=
MAILGUN_SECRET=
SES_KEY=
SES_SECRET=
SES_REGION=ap-south-1
SPARKPOST_SECRET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

EXCHANGE_RATES_API_KEY=
EXCHANGE_RATES_API_ENDPOINT=
FIXER_API_KEY=

OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_REQUEST_TIMEOUT=30

ELASTICSEARCH_HOST=
ELASTICSEARCH_USER=
ELASTICSEARCH_PASS=
ELASTICSEARCH_CLOUD_ID=
ELASTICSEARCH_API_KEY=

SQS_KEY=
SQS_SECRET=
SQS_PREFIX=
SQS_QUEUE=default
SQS_REGION=ap-south-1

STRIPE_KEY=
STRIPE_SECRET=

OCTANE_SERVER=roadrunner
OCTANE_HTTPS=false

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8080

# Frontend dev-only (safe to keep empty in production)
VITE_HOST=
VITE_PORT=
